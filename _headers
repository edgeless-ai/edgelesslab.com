# Cloudflare Pages headers — aggressive caching for versioned assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — cache for one year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Image assets
*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
*.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# SEO monitoring — never cache
/seo-monitoring-weekly/*
  Cache-Control: no-store, max-age=0

# HTML pages — short TTL, stale-while-revalidate for instant refresh
*.html
  Cache-Control: public, max-age=0, must-revalidate
