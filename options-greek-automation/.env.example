# ConvexValue API
CV_API_KEY=cv_live_xxx
CV_API_URL=https://tap.convexvalue.com/api/data

# Alpaca Paper Trading (also reads from ~/.config/alpaca/config.yaml)
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret

# Schwab API (optional, integration pending)
SCHWAB_API_KEY=your_schwab_api_key
SCHWAB_API_SECRET=your_schwab_api_secret
SCHWAB_ACCESS_TOKEN=your_schwab_access_token
SCHWAB_ACCOUNT_NUMBER=your_schwab_account_number
SCHWAB_REFRESH_TOKEN=your_schwab_refresh_token
SCHWAB_TOKEN_RETURN_URL=http://localhost:${PORT}

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Database (optional override)
# DB_PATH=db/data/options_greek.db
